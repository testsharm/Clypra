{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kandel Editor",
  "version": "1.4.2",
  "identifier": "com.clypra.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kandel Editor",
        "width": 1100,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 720,
        "minimizable": true,
        "maximizable": true,
        "dragDropEnabled": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "devtools": true,
        "additionalBrowserArgs": "--enable-gpu-rasterization --ignore-gpu-blocklist --enable-zero-copy --allow-file-access-from-files --enable-features=VaapiVideoDecoder,HardwareMediaKeySystemSupport --enable-hardware-overlays --use-angle=d3d11"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**/*",
            "$DESKTOP/**/*",
            "$DOCUMENT/**/*",
            "$DOWNLOAD/**/*",
            "$VIDEO/**/*",
            "$PUBLIC/**/*",
            "/Volumes/**/*",
            "$APPCACHE/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "testsharm",
    "createUpdaterArtifacts": false,
    "externalBin": [
      "bin/ffmpeg",
      "bin/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {}
}